{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=.;Initial Catalog=SmartStore;Integrated Security=True;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SmartStore": {
    "ApplicationName": "SmartStore.NET",
    "EnableDynamicDiscovery": true,
    "EngineType": "",
    "ThemesBasePath": "~/Themes/",
    "MonitorThemesFolder": true,
    "AreaBasePaths": "~/Plugins/",
    "EnableLocalizedViews": false,
    "EnableVbViews": false,
    "EnableViewLocationCacheDuringDebug": true,
    "ShowCustomErrors": true,
    "EnableLegacyRoutesMapping": false,
    "TempDirectory": "~/App_Data/_temp",
    "TranslateCheckUrl": "https://translate.smartstore.com/StringResource/CheckAvailableResources?version={0}",
    "EfMigrationsCommandTimeout": 120,
    "EfCommandTimeout": 30,
    "MediaStoragePath": "~/App_Data/Tenants/Default/Media",
    "MediaPublicPath": "media"
  },
  "Google": {
    "MerchantID": "",
    "MerchantKey": "",
    "Environment": "Sandbox",
    "AuthenticateCallback": true
  },
  "AllowedHosts": "*"
}
