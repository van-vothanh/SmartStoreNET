<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SmartStore.Core</RootNamespace>
    <AssemblyName>SmartStore.Core</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\AssemblySharedInfo.cs" Link="Properties\AssemblySharedInfo.cs" />
    <Compile Include="..\..\AssemblyVersionInfo.cs" Link="Properties\AssemblyVersionInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude legacy System.Web dependent files -->
    <Compile Remove="Packaging\**\*.cs" />
    <Compile Remove="Fakes\**\*.cs" />
    <Compile Remove="Async\AsyncRunner.cs" />
    <Compile Remove="Async\LocalAsyncState.cs" />
    <Compile Remove="Infrastructure\ContextState.cs" />
    <Compile Remove="Infrastructure\DependencyManagement\AutofacRequestLifetimeHttpModule.cs" />
    <Compile Remove="Infrastructure\DependencyManagement\DefaultLifetimeScopeProvider.cs" />
    <Compile Remove="Infrastructure\DependencyManagement\DefaultLifetimeScopeAccessor.cs" />
    <Compile Remove="Infrastructure\ApplicationStart.cs" />
    <Compile Remove="Infrastructure\WebAppTypeFinder.cs" />
    <Compile Remove="Infrastructure\SmartStoreEngine.cs" />
    <Compile Remove="Infrastructure\ApplicationEnvironment.cs" />
    <Compile Remove="Infrastructure\IApplicationEnvironment.cs" />
    <Compile Remove="IO\VirtualPath\**\*.cs" />
    <Compile Remove="IO\DirectoryHasher.cs" />
    <Compile Remove="IO\LocalFileSystem.cs" />
    <Compile Remove="IO\LockFile\**\*.cs" />
    <Compile Remove="Extensions\HtmlTextWriterExtensions.cs" />
    <Compile Remove="Extensions\RouteExtensions.cs" />
    <Compile Remove="Extensions\HttpExtensions.cs" />
    <Compile Remove="Events\CommonMessages\AppRegisterGlobalFiltersEvent.cs" />
    <Compile Remove="Caching\MemoryCacheManager.cs" />
    <Compile Remove="Caching\RequestCache.cs" />
    <Compile Remove="ComponentModel\TypeConversion\DictionaryConverter.cs" />
    <Compile Remove="ComponentModel\TypeConversion\TypeConverterFactory.cs" />
    <Compile Remove="Plugins\PluginManager.cs" />
    <Compile Remove="Plugins\PluginManager.Cache.cs" />
    <Compile Remove="Plugins\IConfigurable.cs" />
    <Compile Remove="Security\PermissionAttribute.cs" />
    <Compile Remove="Security\SmartStorePrincipal.cs" />
    <Compile Remove="Security\IPermissionService.cs" />
    <Compile Remove="Utilities\CommonHelper.cs" />
    <Compile Remove="Utilities\FileDownloadManager.cs" />
    <Compile Remove="Logging\log4net\Log4netLoggerFactory.cs" />
    <Compile Remove="Logging\log4net\Log4netLogger.cs" />
    <Compile Remove="Collections\TreeNodeBase.cs" />
    <Compile Remove="Collections\TreeNode.cs" />
    <Compile Remove="WebHelper.cs" />
    <Compile Remove="IWebHelper.cs" />
    <Compile Remove="RouteInfo.cs" />
    <Compile Remove="IMergedData.cs" />
    <Compile Remove="Domain\Messages\MessageTemplate.cs" />
    <Compile Remove="Data\DataSettings.cs" />
    <Compile Remove="Data\DataProviderFactory.cs" />
    <Compile Remove="Html\HtmlUtils.cs" />
    <Compile Remove="Themes\DefaultThemeRegistry.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.1.2" />
    <PackageReference Include="Autofac" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.1" />
    <PackageReference Include="HtmlSanitizer" Version="8.0.865" />
    <PackageReference Include="log4net" Version="2.0.17" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.4.1" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.0" />
    <PackageReference Include="System.ServiceModel.Syndication" Version="8.0.0" />
  </ItemGroup>
</Project>
