<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>SmartStore.Core</AssemblyName>
    <RootNamespace>SmartStore.Core</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='EFMigrations|AnyCPU'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='PluginDev|AnyCPU'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" Version="8.0.0" />
    <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="FluentValidation" Version="11.9.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageReference Include="System.Data.Common" Version="4.3.0" />
    <PackageReference Include="System.ServiceModel.Syndication" Version="8.0.0" />
    <PackageReference Include="System.Security.Permissions" Version="8.0.0" />
    <PackageReference Include="System.Runtime.Caching" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\AssemblySharedInfo.cs" Link="Properties\AssemblySharedInfo.cs" />
    <Compile Include="..\..\AssemblyVersionInfo.cs" Link="Properties\AssemblyVersionInfo.cs" />
  </ItemGroup>

  <!-- Exclude problematic System.Web dependent files temporarily -->
  <ItemGroup>
    <Compile Remove="Async\AsyncRunner.cs" />
    <Compile Remove="Caching\**\*.cs" />
    <Compile Remove="Collections\TreeNodeBase.cs" />
    <Compile Remove="Collections\TreeNode.cs" />
    <Compile Remove="Collections\Querystring.cs" />
    <Compile Remove="ComponentModel\**\*.cs" />
    <Compile Remove="Configuration\ISettingService.cs" />
    <Compile Remove="Data\**\*.cs" />
    <Compile Remove="Email\**\*.cs" />
    <Compile Remove="Events\**\*.cs" />
    <Compile Remove="Extensions\**\*.cs" />
    <Compile Remove="Fakes\**\*.cs" />
    <Compile Remove="Html\**\*.cs" />
    <Compile Remove="Infrastructure\ApplicationStart.cs" />
    <Compile Remove="Infrastructure\ApplicationEnvironment.cs" />
    <Compile Remove="Infrastructure\AppDomainTypeFinder.cs" />
    <Compile Remove="Infrastructure\ComparableObject.cs" />
    <Compile Remove="Infrastructure\ContextState.cs" />
    <Compile Remove="Infrastructure\DependencyManagement\**\*.cs" />
    <Compile Remove="Infrastructure\EngineContext.cs" />
    <Compile Remove="Infrastructure\IApplicationEnvironment.cs" />
    <Compile Remove="Infrastructure\IEngine.cs" />
    <Compile Remove="Infrastructure\SmartStoreEngine.cs" />
    <Compile Remove="Infrastructure\WebAppTypeFinder.cs" />
    <Compile Remove="IO\DirectoryHasher.cs" />
    <Compile Remove="IO\ImageHeader.cs" />
    <Compile Remove="IO\LocalFileSystem.cs" />
    <Compile Remove="IO\LockFile\**\*.cs" />
    <Compile Remove="IO\VirtualPath\**\*.cs" />
    <Compile Remove="IStoreContext.cs" />
    <Compile Remove="IWorkContext.cs" />
    <Compile Remove="Linq\**\*.cs" />
    <Compile Remove="Localization\**\*.cs" />
    <Compile Remove="Logging\**\*.cs" />
    <Compile Remove="Money.cs" />
    <Compile Remove="PagedList.cs" />
    <Compile Remove="PagedList`T.cs" />
    <Compile Remove="Packaging\**\*.cs" />
    <Compile Remove="Plugins\**\*.cs" />
    <Compile Remove="RouteInfo.cs" />
    <Compile Remove="Rules\**\*.cs" />
    <Compile Remove="Search\**\*.cs" />
    <Compile Remove="Security\**\*.cs" />
    <Compile Remove="Themes\**\*.cs" />
    <Compile Remove="Utilities\**\*.cs" />
    <Compile Remove="WebHelper.cs" />
    <Compile Remove="IWebHelper.cs" />
    <Compile Remove="IMergedData.cs" />
  </ItemGroup>

  <!-- Remove EF6 Index attributes from domain entities -->
  <ItemGroup>
    <Compile Remove="Domain\**\*.cs" />
  </ItemGroup>

</Project>
